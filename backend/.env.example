# ==========================================
# Backend Environment Configuration
# ==========================================

# Server Listening Port
PORT=8000

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<database>?retryWrites=true&w=majority
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/bookstore?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bookstore?retryWrites=true&w=majority

# JWT Authentication Secret Key & Expiration
JWT_SECRET=replace_with_a_secure_jwt_secret_key
JWT_EXPIRES_IN=1h
